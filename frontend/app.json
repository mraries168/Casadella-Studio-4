{
  "expo": {
    "name": "Casadella Studio",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.casadellastudio.c442b0",
      "infoPlist": {
        "NSCameraUsageDescription": "Foto struk sebagai bukti pengeluaran",
        "NSPhotoLibraryUsageDescription": "Lampirkan foto struk sebagai bukti pengeluaran",
        "NSLocationWhenInUseUsageDescription": "Absen hanya saat Anda berada di studio"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.casadellastudio.c442b0",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lampirkan foto struk sebagai bukti pengeluaran",
          "cameraPermission": "Foto struk sebagai bukti pengeluaran"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Absen hanya saat Anda berada di studio"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}